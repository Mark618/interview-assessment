    {
      "parameters": {
        "jsCode": "const input = $('Chat1').first().json.chatInput.toLowerCase().trim();\n\n// Default values\nlet command = \"help\";\nlet difficulty = \"easy\"; \n// Regex to catch \"start\" followed by an optional difficulty\nconst startMatch = input.match(/^start\\s*(easy|medium|hard)?/);\n\nif (startMatch) {\n    command = \"start\";\n    if (startMatch[1]) {\n        difficulty = startMatch[1];\n    }\n} else if (input.includes(\"stats\") || input.includes(\"leaderboard\")) {\n    command = \"stats\";\n} else if (input.includes(\"quit\") || input.includes(\"end\")) {\n    command = \"quit\";\n} else if (input.includes(\"help\")) {\n    command = \"help\";\n}\n\nreturn [{\n    json: {\n        command,\n        difficulty,\n        user_input: input,\n        user_name: $('Information Extractor').first().json.output.user_name,\n        is_command: command !== \"play_word\"\n    }\n}];"
      },
