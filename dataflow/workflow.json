    {
      "parameters": {
        "jsCode": "const userinput = $input.first().json.chatInput.toLowerCase().trim();\nconst match = userinput.match(/^submit\\s+(\\S+)$/);\n\nconst lastWord = $('checkRecord').first().json.outcome;\nconst difficulty = $('checkRecord').first().json.difficulty;\n\nlet isValid = true;\nlet errorReason = \"\";\nlet userWord = null;\n\nif (match) {\n  userWord = match[1];\n  if (lastWord && lastWord.length > 0) {\n      const lastLetter = lastWord.slice(-1);      \n      if (!userWord.startsWith(lastLetter)) {\n          isValid = false;\n          errorReason = `Your word must start with the letter \"${lastLetter.toUpperCase()}\".`;\n      }\n  }\n} \nelse {\n    isValid = false;\n    errorReason = \"Please use the format: submit [word]\";\n}\n\nreturn [{\n    json: {\n        isValid,\n        errorReason,\n        userWord,\n        difficulty,\n        current_round: $('checkRecord').first().json.current_round\n    }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1936,
        -1552
      ],
      "id": "71aefe11-6b53-4c18-80ff-4e03cae964b4",
